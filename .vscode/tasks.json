{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Go: Run canonical test from current file",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\run_test_from_file.ps1",
                "-goFile",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        }
    ],
    "presentation": {
        "echo": false,
        "showReuseMessage": false
    }
}